{
  "name": "pipanoar-exemplo-expo",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "prebuild": "expo prebuild",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:release": "expo run:android --variant release",
    "ios:release": "expo run:ios --configuration Release",
    "typecheck": "tsc --noEmit",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios",
    "deploy:android": "hot-updater deploy -p android -t $(node -p \"require('./app.json').expo.version\")",
    "deploy:ios": "hot-updater deploy -p ios -t $(node -p \"require('./app.json').expo.version\")"
  },
  "dependencies": {
    "@hot-updater/react-native": "1.0.6",
    "expo": "~56.0.23",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "react": "19.2.3",
    "react-native": "0.85.3"
  },
  "devDependencies": {
    "@hot-updater/expo": "1.0.6",
    "@pipanoar/hot-updater": "^0.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "hot-updater": "1.0.6",
    "typescript": "~6.0.3"
  }
}
